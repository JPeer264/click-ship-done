{
  "name": "click-ship-done",
  "version": "0.1.0",
  "description": "Demo of the talk \"Click. Ship. Done. AI Agents on Cloudflare\": a chat agent with a weather MCP server in one Worker.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "vite dev",
    "deploy": "vite build && wrangler deploy",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@cloudflare/ai-chat": "^0.10.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/cloudflare": "^11.11.0",
    "@sentry/react": "^11.11.0",
    "agents": "^0.20.1",
    "ai": "^7.0.37",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "streamdown": "^2.5.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "wrangler": "^4.158.0"
  },
  "cloudflare": {
    "bindings": {
      "SENTRY_DSN": {
        "description": "Optional. The DSN of your [Sentry](https://sentry.io) project, to see the errors and traces of the agent. Leave it empty to run without Sentry."
      }
    }
  }
}
