{
  "name": "click-ship-done",
  "version": "0.1.0",
  "description": "Demo of the talk \"Click. Ship. Done. AI Agents on Cloudflare\": a chat agent with a weather MCP server in one Worker.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite dev",
    "deploy": "vite build && wrangler deploy",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.36",
    "@ai-sdk/react": "^4.0.167",
    "@cloudflare/ai-chat": "^0.12.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/cloudflare": "^11.11.0",
    "@sentry/react": "^11.11.0",
    "agents": "^0.33.0",
    "ai": "^7.0.163",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.158.0"
  },
  "cloudflare": {
    "bindings": {
      "SENTRY_DSN": {
        "description": "Optional. Replace `off` with the DSN of your [Sentry](https://sentry.io) project, to see the errors and traces of the agent. Keep `off` to run without Sentry."
      }
    }
  }
}
