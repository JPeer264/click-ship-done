{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "click-ship-done",
  "main": "src/agent.ts",
  "compatibility_date": "2026-04-01",
  // global_fetch_strictly_public: the agent connects to the MCP server of this same Worker over its public URL.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/mcp", "/config.json"]
  },
  "durable_objects": {
    "bindings": [{ "class_name": "ChatAgent", "name": "ChatAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "upload_source_maps": true
}
