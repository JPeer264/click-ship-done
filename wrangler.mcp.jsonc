{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "click-ship-done-mcp",
  "main": "src/mcp.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "a309069218044959b14d6ce7d7fa9088" }
  ],
  // GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are set with:
  //   wrangler secret put GITHUB_CLIENT_ID -c wrangler.mcp.jsonc
  //   wrangler secret put GITHUB_CLIENT_SECRET -c wrangler.mcp.jsonc
  "observability": { "enabled": true }
}
